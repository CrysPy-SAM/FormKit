# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed — see env-setup.sh, which
# copies this file to .env automatically on first run if .env is missing.
#
# Every value below is a placeholder. Do not commit real secrets here.

# ==================================
# APP / SERVER
# ==================================
PORT=8080
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:8080
OPEN_API_BASE_URL=http://localhost:8080/api/v1
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=debug

# ==================================
# WEB (Next.js)
# ==================================
# Server-side base URL the browser talks to.
NEXT_PUBLIC_API_URL=http://localhost:8080/trpc

# ==================================
# DATABASE (Postgres via Drizzle)
# ==================================
DATABASE_URL=postgresql://formkit:formkit@localhost:5432/formkit

# ==================================
# REDIS / VALKEY (cache + BullMQ)
# ==================================
REDIS_URL=redis://localhost:6379

# ==================================
# AUTH — generate strong, unique random values for each of these.
# Never reuse a value across environments (dev/staging/prod), and never
# commit real values. Rotate immediately if one is ever exposed.
# e.g. `openssl rand -hex 32`
# ==================================
COOKIE_SECRET=replace-with-a-long-random-value
ACCESS_TOKEN_SECRET=replace-with-a-long-random-value
REFRESH_TOKEN_SECRET=replace-with-a-long-random-value

# ==================================
# EMAIL (Resend)
# ==================================
RESEND_API_KEY=replace-with-your-resend-api-key
MAIL_FROM_ADDRESS=onboarding@yourdomain.com

# ==================================
# GOOGLE OAUTH
# GOOGLE_CLIENT_ID is a public OAuth client identifier, not a secret — it is
# intentionally re-exposed to the browser under the NEXT_PUBLIC_ prefix below
# (required for Next.js to inline it into the client bundle). This flow does
# not use a client secret (ID-token verification only).
# ==================================
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id.apps.googleusercontent.com
