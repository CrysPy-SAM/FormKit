{
  "name": "@formkit/db",
  "main": "./src/index.js",
  "private": true,
  "type": "module",
  "scripts": {
    "db:generate": "dotenv -- drizzle-kit generate",
    "db:migrate": "dotenv -- drizzle-kit migrate",
    "db:push": "dotenv -- drizzle-kit push",
    "db:studio": "dotenv -- drizzle-kit studio",
    "db:seed": "dotenv -- tsx src/scripts/seed.ts",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@formkit/config": "workspace:*",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@formkit/typescript-config": "workspace:*",
    "@formkit/logger": "workspace:*",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "1.0.0-rc.4",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}